# LCM v2 Configuration

# Store driver: 'postgres' (default, production-grade) or 'sqlite' (embedded, dev-only)
LCM_STORE_DRIVER=postgres

# SQLite config (only when LCM_STORE_DRIVER=sqlite)
LCM_SQLITE_PATH=~/.lcm-v2/lcm.db

# PostgreSQL config (only when LCM_STORE_DRIVER=postgres)
DATABASE_URL=postgresql://lcm:lcm@localhost:5432/lcm_v2
LCM_PG_MAX_CONNECTIONS=10
LCM_PG_SSL=false

# Embedding config
LCM_EMBEDDING_DIMENSIONS=384
# LCM_EMBEDDING_API_URL=http://localhost:8082/embed

# Ingestion pipeline
LCM_PII_MODE=annotate          # annotate | redact_in_summaries | redact_everywhere
LCM_COMPRESSION_THRESHOLD=200  # min chars to trigger pre-compression
LCM_EMBED_ON_INGEST=true

# Compaction thresholds (for future compaction engine)
LCM_CONTEXT_THRESHOLD=0.75
LCM_FRESH_TAIL_COUNT=32
LCM_LEAF_CHUNK_TOKENS=20000
